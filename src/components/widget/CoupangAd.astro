---
interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
const VIDEO_SRC = "/assets/partners/sten-dripper-shorts.mp4";
const POSTER_SRC = "/assets/partners/sten-dripper-poster.jpg";
const COUPANG_URL = "https://link.coupang.com/a/i0VQmSScDs";
---

<div class:list={["card-base p-4 text-center border border-black/[0.05] dark:border-white/[0.06]", className]} style={style}>
	<div class="text-[11px] font-semibold tracking-wider uppercase text-black/45 dark:text-white/45 mb-2">
		AD · 홈카페 추천
	</div>

	<div class="relative w-full max-w-[230px] mx-auto aspect-[9/16] rounded-lg overflow-hidden mb-2 bg-black border border-black/[0.06] dark:border-white/[0.08]">
		<video
			src={VIDEO_SRC}
			poster={POSTER_SRC}
			controls
			playsinline
			preload="metadata"
			data-partner-video
			class="w-full h-full object-cover block"
		>
			브라우저가 비디오 재생을 지원하지 않습니다.
		</video>
	</div>

	<div class="mb-3">
		<button
			type="button"
			data-partner-fullscreen
			class="inline-flex items-center justify-center gap-1 rounded-md px-2.5 py-1 text-[11px] font-medium text-black/65 dark:text-white/65 hover:text-black dark:hover:text-white bg-black/[0.04] dark:bg-white/[0.06] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] transition-colors cursor-pointer border-0"
		>
			<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-none stroke-current stroke-2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
			</svg>
			<span>전체화면 보기</span>
		</button>
	</div>

	<a
		href={COUPANG_URL}
		target="_blank"
		rel="sponsored noopener noreferrer"
		class="group block no-underline"
	>
		<div class="font-semibold text-sm text-black/85 dark:text-white/90 mb-1 break-keep">
			발룬피니 스텐 304 드리퍼
		</div>
		<div class="text-xs text-black/60 dark:text-white/60 mb-3 break-keep leading-snug">
			이중 미세망 · 컬러핸들 내열유리 계량컵 2세트
		</div>
		<span class="inline-flex items-center justify-center rounded-lg btn-regular text-xs font-semibold px-3.5 py-2 w-full">
			쿠팡에서 확인하기
		</span>
	</a>

	<p class="text-[11px] font-medium text-black/70 dark:text-white/70 mt-3 pt-2.5 border-t border-black/[0.07] dark:border-white/[0.09] leading-relaxed break-keep">
		이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
	</p>
</div>

<script is:inline>
	if (!window.__partnerVideoFsBound) {
		window.__partnerVideoFsBound = true;
		document.addEventListener("click", (event) => {
			const btn = event.target instanceof Element ? event.target.closest("[data-partner-fullscreen]") : null;
			if (!btn) return;
			const card = btn.closest(".card-base");
			const video = card ? card.querySelector("[data-partner-video]") : null;
			if (!video) return;
			if (video.requestFullscreen) {
				video.requestFullscreen().catch(() => {});
			} else if (video.webkitEnterFullscreen) {
				video.webkitEnterFullscreen();
			}
			if (video.paused) {
				video.play().catch(() => {});
			}
		});
	}
</script>
