---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.25rem] w-[3.25rem] border border-black/10 dark:border-white/10 shadow-md">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style>
.back-to-top-wrapper {
    width: 3.25rem;
    height: 3.25rem;
    position: absolute;
    right: 0;
    top: 0;
    pointer-events: none;
}

.back-to-top-btn {
    color: var(--primary);
    font-size: 2rem;
    font-weight: bold;
    border: none;
    position: fixed;
    right: max(1.5rem, calc((100vw - var(--page-width)) / 2 + 1rem));
    bottom: 2.5rem;
    z-index: 40;
    opacity: 1;
    cursor: pointer;
    transform: translateY(0);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: auto;
}

.back-to-top-btn i {
    font-size: 1.75rem;
}

.back-to-top-btn.hide {
    transform: translateY(0.5rem) scale(0.9);
    opacity: 0;
    pointer-events: none;
}

.back-to-top-btn:active {
    transform: scale(0.92);
}
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
